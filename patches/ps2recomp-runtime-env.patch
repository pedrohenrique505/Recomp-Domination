+            indexedImage = image;
+            lbnByPath.clear();
+            std::ifstream iso(image, std::ios::binary);
+            auto readSector = [&](uint32_t lbn, std::vector<uint8_t> &out, uint32_t count) -> bool
+            {
+                out.assign(static_cast<size_t>(count) * kCdSectorSize, 0u);
+                iso.seekg(static_cast<std::streamoff>(lbn) * kCdSectorSize);
+                return static_cast<bool>(iso.read(reinterpret_cast<char *>(out.data()), static_cast<std::streamsize>(out.size())));
+            };
+            auto u32 = [](const uint8_t *p) { return static_cast<uint32_t>(p[0] | (p[1] << 8) | (p[2] << 16) | (p[3] << 24)); };
+            std::vector<uint8_t> pvd;
