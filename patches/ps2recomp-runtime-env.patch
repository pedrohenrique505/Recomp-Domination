+    // O IOP emulado lê a imagem pelo setor real; se o EE devolver um setor inventado no sceCdSearchFile,
+    // módulos IOP que recebem esse setor do jogo (ex. 989snd carregando bancos) leem o lugar errado.
+    bool findIsoFileLbn(const std::string &ps2Path, uint32_t &lbnOut)
+    {
+        static std::filesystem::path indexedImage;
+        static std::unordered_map<std::string, uint32_t> lbnByPath; // caminho em minúsculas, sem ";1"
