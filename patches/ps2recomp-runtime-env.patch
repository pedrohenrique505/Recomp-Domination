+        const bool is32 = mode == C32 || mode == C24 || mode == Z32 || mode == Z24;
+        const bool is16 = mode == C16 || mode == C16S || mode == Z16 || mode == Z16S;
+        if ((!is32 && !is16) || (base & 31u) != 0u)
+        {
+            for (int y = y0; y <= y1; ++y)
